<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AttroRevenueCat privacy manifest. This module collects nothing itself: it
  reads the RevenueCat app user id, calls AttroSDK (see its manifest) and sets
  one RevenueCat subscriber attribute (attro_attribution_id, a server-issued
  row id). RevenueCat's own SDK ships its own manifest.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
