<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AttroSDK privacy manifest. It declares exactly what the SDK sends to Attro:

  - Device ID: the install id, a random UUID the SDK generates and keeps in the
    Keychain (this-device-only). It is not derived from any device property and
    is not the advertising identifier.
  - User ID: the RevenueCat app user id the app passes in (and, in user-token
    mode, the token the app's backend issued for it). The refer-a-friend calls
    send the user's access token, from which the server derives the user.
  - Product Interaction: that the app was opened by an Attro Universal Link
    (the link URL) or that the user typed an affiliate code.

  All of it is linked to the user (the attribution is bound to the app user id)
  and used only to attribute the app's own purchases to the affiliate who
  referred the user (developer's marketing) and for the refer-a-friend feature
  (app functionality). None of it is used for tracking as defined by App
  Tracking Transparency, and the SDK contacts no tracking domain.

  The SDK does not read the IDFA, screen size, time zone, locale, system boot
  time, disk space, keyboards or file timestamps. The opt-in probabilistic
  install match (off by default) sends the app's WebKit User-Agent; the server
  compares it and the request IP with a click on the tenant's own download page.
  Apps that turn it on must review their own App Privacy answers.

  Required-reason API: UserDefaults (CA92.1), for SDK state readable only by the
  app itself (current attribution id, pending retries, cached User-Agent).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
