{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The affiliate code the user typed."
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Identifies this attempt; a retry reuses it and gets the same answer."
    },
    "installId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Per-install id generated by the app (a UUID kept in the Keychain or app storage)."
    },
    "appUserId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "RevenueCat app user id at the time of the touch."
    },
    "appUserToken": {
      "description": "Required in user-token mode.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "code",
    "requestId",
    "installId",
    "appUserId"
  ],
  "$id": "https://get-attro.com/contracts/device/code-attribution-request.schema.json"
}
