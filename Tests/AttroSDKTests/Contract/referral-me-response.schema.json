{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "shareUrl": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tokensEarned": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tokensPending": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tokenBalance": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "completed",
        "pending",
        "tokensEarned",
        "tokensPending",
        "tokenBalance"
      ],
      "additionalProperties": false
    },
    "defaultReward": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "tokenCost": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "fulfillmentData": {}
          },
          "required": [
            "id",
            "name",
            "tokenCost",
            "fulfillmentData"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "code",
    "shareUrl",
    "stats",
    "defaultReward"
  ],
  "additionalProperties": false,
  "$id": "https://get-attro.com/contracts/device/referral-me-response.schema.json"
}
